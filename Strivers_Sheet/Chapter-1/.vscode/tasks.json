{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "g++ build and run with input/output",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "g++ -g ${file} -o ${fileDirname}\\${fileBasenameNoExtension}.exe && ${fileDirname}\\${fileBasenameNoExtension}.exe < ${fileDirname}\\input.txt > ${fileDirname}\\output.txt"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}
